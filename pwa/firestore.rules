rules_version = '2';

// Faza 1: doar dispecerul (contul autorizat) citește/scrie datele de bază.
// 3 documente cu ID fix (couriers/addresses/routes), fiecare cu array-ul/obiectul
// complet — traducere directă a celor 3 chei localStorage folosite până acum.
//
// Faza 2: courierRuns — un document per traseu trimis unui curier. Curierul se
// autentifică anonim și primește linkul cu ID-ul documentului (secretul e ID-ul
// însuși, negăsibil prin ghicire — Firestore auto-ID, ~120 biți). "list" e explicit
// interzis, ca niciun cont anonim să nu poată enumera traseele altor curieri/clienți
// (get pe un ID cunoscut e permis; o interogare pe toată colecția, nu).
//
// Faza 3: lastPos (poziția GPS live a curierului) adăugat la câmpurile permise la update.
//
// Faza 4: stops — un document per oprire, generat de dispecer odată cu courierRuns
// (vezi app.js createCourierRun), conținând STRICT ce are voie să vadă acel client — nu
// traseul complet, nu alți clienți. Același model "get pe ID exact, list interzis" ca la
// courierRuns. Clientul poate scrie DOAR clientConfirmed/clientNote — restul câmpurilor
// (status, stopsAhead, poziția curierului) sunt scrise exclusiv de Cloud Functions
// (functions/index.js, drepturi admin, ocolesc aceste reguli complet).
service cloud.firestore {
  match /databases/{database}/documents {
    function isDispatcher() {
      return request.auth != null
        && request.auth.token.email == 'alinaoprea99@gmail.com';
    }

    match /dispatcherData/{docId} {
      allow read, write: if isDispatcher();
    }

    match /courierRuns/{runId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isDispatcher();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stops', 'lastPos']);
      allow delete: if false;
    }

    match /stops/{stopId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isDispatcher();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientConfirmed', 'clientNote']);
      allow delete: if false;
    }
  }
}
